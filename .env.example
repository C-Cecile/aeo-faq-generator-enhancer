# Copy this file to .env (same folder) and fill in your DataForSEO credentials.
# Get them at https://app.dataforseo.com/api-access — never commit the .env file.
#
# This is only one of the routes the tool accepts. If you already keep these in
# your shell environment, or behind a secrets proxy, you don't need this file at
# all — run `python faqgen.py --check` to see what it finds.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Alternative: a single base64 login:password token, if that's what you were
# given. Use this INSTEAD of the two lines above, not as well as.
# DATAFORSEO_AUTH=

# Alternative: a secrets proxy that holds the keys for you.
# SECRETS_PROXY_BASE=http://your-host:8900

# Optional defaults (can also be passed as --location / --language flags)
FAQGEN_LOCATION=us
FAQGEN_LANGUAGE=en
